# Salin file ini menjadi .env.local dan isi dengan nilai asli kamu.
# JANGAN commit file .env.local ke GitHub.

# Alamat situs saat sudah online, tanpa garis miring di akhir.
# Contoh: https://filup.my.id
# Dipakai untuk membentuk URL absolut pada tag Open Graph, sitemap.xml, dan
# robots.txt. Kalau dikosongkan, aplikasi memakai http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Firebase (Project Settings > General > Your apps > SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Gemini API (ambil di https://aistudio.google.com/apikey)
# Tanpa prefix NEXT_PUBLIC_ karena hanya dipakai di server (API routes),
# supaya key tidak pernah terkirim ke browser.
GEMINI_API_KEY=

# Opsional. Kalau dikosongkan, aplikasi memakai "gemini-3.7-flash".
# Isi ini hanya kalau modelnya dihentikan Google atau kamu ingin ganti model.
# Cek daftar model aktif di: https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=

# Opsional. Model cadangan, dipisah koma. Kalau model utama sedang penuh
# (error 503 "high demand"), aplikasi otomatis mencoba yang ada di daftar ini.
# Default kalau dikosongkan: gemini-3.6-flash,gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
